# --- Private, shared with the team outside GitHub ---

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Environment ---
.venv/
.env

# --- Tests and tooling ---
.pytest_cache/
.coverage
htmlcov/
.sandbox/

# --- ScribeSense data (never commit user or test databases) ---
*.db
*.db-wal
*.db-shm
*.sqlite

# --- Browser extension signing keys (never commit) ---
*.pem
*.crx

# --- Exception: the signed extension automatic setup looks for (never the signing key itself) ---
# `dist/` above also matches `extension/dist/`, so the directory must be un-ignored first, or the
# file-level exception below has nothing to apply to (a known git gitignore gotcha). Re-ignoring
# everything else under it keeps other build intermediates (e.g. *.js) out, same as before.
!extension/dist/
extension/dist/*
!extension/dist/scribesense.crx

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
